<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_dark" />
        </shape>
    </item>
    <!-- Top Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="@color/divider" />
        </shape>
    </item>
    <!-- Bottom Border (using inset to show only top and bottom) -->
    <item android:top="0.5dp" android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_dark" />
        </shape>
    </item>
</layer-list>