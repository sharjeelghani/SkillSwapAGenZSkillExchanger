<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state (Checked) -->
    <item android:state_checked="true">
        <layer-list>
            <!-- bright mint fill -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/mint_primary"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <!-- white stroke for accent -->
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1.8dp" android:color="@color/white"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state -->
    <item>
        <layer-list>
            <!-- dark translucent fill -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_fill_trans"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
            <!-- neon stroke -->
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1.8dp" android:color="@color/neon_stroke"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
