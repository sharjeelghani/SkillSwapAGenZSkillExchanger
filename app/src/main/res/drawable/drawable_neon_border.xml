<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glowing rounded rect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/neon_border_a"
                android:endColor="@color/neon_border_b"/>
            <corners android:radius="@dimen/card_corner_radius"/>
        </shape>
    </item>

    <!-- Inset to create inner dark area (the actual card surface) -->
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_surface_translucent"/>
            <corners android:radius="@dimen/card_corner_radius"/>
        </shape>
    </item>

    <!-- Soft outer glow (semi-transparent) as another layer to imitate glow -->
    <item android:bottom="-16dp" android:left="-16dp" android:right="-16dp" android:top="-16dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A00FFD6"/>
            <corners android:radius="@dimen/card_corner_radius"/>
        </shape>
    </item>
</layer-list>
