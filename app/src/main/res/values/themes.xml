<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SkillSwapAGenZSkillExchanger" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:statusBarColor">#103238</item>
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.SkillSwapAGenZSkillExchanger" parent="Base.Theme.SkillSwapAGenZSkillExchanger" />
    <style name="NeonRadioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/neon_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:drawablePadding">18dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableLeft">@drawable/radio_unchecked</item>
    </style>
    <style name="NeonButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="MyTabLayoutTextAppearance" parent="@style/TextAppearance.AppCompat.Widget.ActionBar.Title.Inverse">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="SelectableChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="chipStrokeColor">@color/mint_primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/chip_corner</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipIconVisible">false</item>
        <item name="android:paddingLeft">@dimen/chip_padding_h</item>
        <item name="android:paddingRight">@dimen/chip_padding_h</item>
        <item name="android:paddingTop">@dimen/chip_padding_v</item>
        <item name="android:paddingBottom">@dimen/chip_padding_v</item>
    </style>

    <style name="GenderRadio">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:buttonTint">@color/mint_primary</item>
    </style>

    <style name="InputField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_input_outline</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="NeonRadio">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@drawable/neon_button_outline</item>
        <item name="android:textColor">@color/radio_text_selector</item>
        <item name="android:textSize">16sp</item>
        <item name="android:buttonTint">@color/radio_button_tint_selector</item>
    </style>
</resources>
