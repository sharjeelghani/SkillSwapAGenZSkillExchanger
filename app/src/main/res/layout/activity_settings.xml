<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02131C">

    <ScrollView
        android:id="@+id/scroll_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Account -->
            <LinearLayout
                android:id="@+id/row_account"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_setting_item">

                <ImageView
                    android:id="@+id/icon_account"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_account"
                    app:tint="#7AF2DD"/>

                <TextView
                    android:id="@+id/tv_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="Account Settings"
                    android:textColor="#E8FFF9"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- Privacy -->
            <LinearLayout
                android:id="@+id/row_privacy"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_setting_item">

                <ImageView
                    android:id="@+id/icon_privacy"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_privacy"
                    app:tint="#7AF2DD"/>

                <TextView
                    android:id="@+id/tv_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="Privacy"
                    android:textColor="#E8FFF9"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- Security -->
            <LinearLayout
                android:id="@+id/row_security"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_setting_item">

                <ImageView
                    android:id="@+id/icon_security"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_security"
                    app:tint="#7AF2DD"/>

                <TextView
                    android:id="@+id/tv_security"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="Security"
                    android:textColor="#E8FFF9"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- Help -->
            <LinearLayout
                android:id="@+id/row_help"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_setting_item">

                <ImageView
                    android:id="@+id/icon_help"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_help"
                    app:tint="#7AF2DD"/>

                <TextView
                    android:id="@+id/tv_help"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="Help"
                    android:textColor="#E8FFF9"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- Log Out button (full-width gradient) -->
            <FrameLayout
                android:id="@+id/logout_container"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_logout_button"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Log Out"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </FrameLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
