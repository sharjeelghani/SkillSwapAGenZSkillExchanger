<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#021B1F">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="start"
                android:src="@drawable/delete"/>
            <!-- Title -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rate the session"
                android:textColor="#7AF2DD"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <!-- Stars row -->
            <LinearLayout
                android:id="@+id/layout_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="18dp">

                <ImageView
                    android:id="@+id/star1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#4CFFC7"
                    android:layout_marginEnd="6dp"/>

                <ImageView
                    android:id="@+id/star2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#4CFFC7"
                    android:layout_marginEnd="6dp"/>

                <ImageView
                    android:id="@+id/star3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#4CFFC7"
                    android:layout_marginEnd="6dp"/>

                <ImageView
                    android:id="@+id/star4"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#4CFFC7"
                    android:layout_marginEnd="6dp"/>

                <ImageView
                    android:id="@+id/star5"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="#4CFFC7"/>
            </LinearLayout>

            <!-- Feedback box -->
            <EditText
                android:id="@+id/et_feedback"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_certificate_card"
                android:padding="18dp"
                android:gravity="top|start"
                android:hint="Share your feedback"
                android:textColor="#DFFFF8"
                android:textColorHint="#27F3B3"
                android:textSize="16sp"
                android:inputType="textMultiLine"
                android:maxLines="6" />

            <!-- Badge row -->
            <LinearLayout
                android:id="@+id/layout_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp">

                <TextView
                    android:id="@+id/tv_badge_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nominate a badge for\nSharjeel"
                    android:textColor="#7AF2DD"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btn_select_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_certificate_card"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Select Badge"
                    android:textColor="#DFFFF8"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Submit button -->
            <TextView
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="56dp"
                android:background="@drawable/bg_logout_button"
                android:gravity="center"
                android:text="Submit"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="20sp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
