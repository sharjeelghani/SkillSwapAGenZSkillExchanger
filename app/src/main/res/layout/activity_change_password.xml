<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02131C"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="CHANGE PASSWORD"
        android:textAllCaps="true"
        android:textColor="#27F3B3"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"/>

    <!-- Current Password -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_input_outline"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <EditText
            android:id="@+id/et_current_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/iv_eye_current"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            android:hint="Current Password"
            android:inputType="textPassword"
            android:textColor="#27F3B3"
            android:textColorHint="#27F3B3"
            android:textSize="16sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/iv_eye_current"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_eye"
            app:tint="#27F3B3" />
    </RelativeLayout>

    <!-- New Password -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_outline"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <EditText
            android:id="@+id/et_new_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/iv_eye_new"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            android:hint="New Password"
            android:inputType="textPassword"
            android:textColor="#27F3B3"
            android:textColorHint="#27F3B3"
            android:textSize="16sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/iv_eye_new"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_eye"
            app:tint="#27F3B3" />
    </RelativeLayout>

    <!-- Match New Password -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_outline"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <EditText
            android:id="@+id/et_match_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/iv_eye_match"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            android:hint="Match New Password"
            android:inputType="textPassword"
            android:textColor="#27F3B3"
            android:textColorHint="#27F3B3"
            android:textSize="16sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/iv_eye_match"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_eye"
            app:tint="#27F3B3" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="At least 8 Characters\nOne Capital Letter\nNo Symbols Except _"
        android:textColor="#27F3B3"
        android:textSize="12sp"
        android:alpha="0.7"
        android:paddingStart="18dp"
        android:paddingEnd="18dp" />

    <TextView
        android:id="@+id/btn_update_password"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_signup_btn"
        android:gravity="center"
        android:text="Update Password"
        android:textColor="#02131C"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
