<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Center neon card -->
    <FrameLayout
        android:id="@+id/neon_card_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/card_outer_padding"
        android:layout_marginHorizontal="@dimen/activity_margin"
        android:layout_marginTop="@dimen/top_margin"
        android:layout_marginBottom="@dimen/activity_margin"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:foregroundGravity="center"
        android:layout_marginStart="@dimen/activity_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Outer glowing rounded border (layer-list drawable) -->
        <View
            android:id="@+id/neon_border"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/drawable_neon_border"
            android:padding="@dimen/card_inner_padding"
            android:layout_gravity="center" />

        <!-- inner dark translucent surface -->
        <LinearLayout
            android:id="@+id/card_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="@dimen/card_inner_spacing"
            android:paddingStart="@dimen/card_content_padding"
            android:paddingEnd="@dimen/card_content_padding"
            android:paddingTop="@dimen/card_content_padding_top"
            android:paddingBottom="@dimen/card_content_padding"
            android:gravity="center_horizontal"
            android:background="@drawable/drawable_card_surface"
            android:layout_gravity="center">

            <!-- Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION REMINDER"
                android:textAllCaps="true"
                android:textSize="@dimen/title_size"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:layout_marginTop="@dimen/title_top_margin"
                android:shadowColor="@color/neon_shadow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:textColor="@color/neon_text" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your upcoming session \nstarts soon"
                android:textSize="@dimen/subtitle_size"
                android:textAlignment="center"
                android:gravity="center"
                android:fontFamily="sans-serif"
                android:layout_marginTop="@dimen/subtitle_top_margin"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/subtle_neon" />

            <!-- Time -->
            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today · 4:00 PM"
                android:textSize="@dimen/time_size"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="@dimen/time_top_margin"
                android:layout_marginBottom="@dimen/time_bottom_margin"
                android:shadowColor="@color/neon_shadow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="12"
                android:textColor="@color/time_text" />

            <!-- Button container to give breathing space -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/button_container_margin"
                android:layout_marginBottom="@dimen/button_container_bottom_margin">

                <RelativeLayout
                    android:id="@+id/btn_view_session"
                    style="@style/NeonButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_gravity="center"
                    android:background="@drawable/gradient_button"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:shadowColor="@color/button_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Session"
                        android:fontFamily="@font/nunito_semibold"
                        android:textColor="@color/button_text"
                        android:textSize="18sp"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
