<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#02131C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_otp_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_otp_verification"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verification Code"
            android:textColor="#27F3B3"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tv_otp_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter the 6-digit code sent to your email."
            android:textColor="#BFFFEF"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <EditText
                android:id="@+id/et_otp1"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textColor="#27F3B3"
                android:layout_margin="4dp"/>
            <EditText
                android:id="@+id/et_otp2"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textColor="#27F3B3"
                android:layout_margin="4dp"/>
            <EditText
                android:id="@+id/et_otp3"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textColor="#27F3B3"
                android:layout_margin="4dp"/>
            <EditText
                android:id="@+id/et_otp4"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textColor="#27F3B3"
                android:layout_margin="4dp"/>
            <EditText
                android:id="@+id/et_otp5"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textColor="#27F3B3"
                android:layout_margin="4dp"/>
            <EditText
                android:id="@+id/et_otp6"
                android:layout_width="40dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textSize="20sp"
                android:textColor="#27F3B3"
                android:layout_margin="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01:00"
            android:textColor="#27F3B3"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_resend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend Code"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="#27F3B3"/>

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Confirm Code"
            android:backgroundTint="#27F3B3"
            android:textColor="#02131C"
            android:layout_marginTop="24dp"
            android:textStyle="bold"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
