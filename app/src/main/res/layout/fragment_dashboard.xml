<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020C15">

    <ScrollView
        android:id="@+id/scroll_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TOP STATS ROW -->
            <LinearLayout
                android:id="@+id/layout_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- My Skills -->
                <LinearLayout
                    android:id="@+id/card_my_skills"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_card"
                    android:padding="16dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/icon_my_skills"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_my_skills"
                        app:tint="#18FCE6" />

                    <TextView
                        android:id="@+id/tv_label_my_skills"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="My Skills"
                        android:textColor="#DFFFF8"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_count_my_skills"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="3"
                        android:textColor="#18FCE6"
                        android:textSize="26sp" />
                </LinearLayout>

                <!-- Available Matches -->
                <LinearLayout
                    android:id="@+id/card_matches"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_card"
                    android:padding="16dp"
                    android:gravity="center_horizontal"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:id="@+id/icon_matches"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_matches"
                        app:tint="#18FCE6" />

                    <TextView
                        android:id="@+id/tv_label_matches"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Available\nMatches"
                        android:textColor="#DFFFF8"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_count_matches"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="5"
                        android:textColor="#18FCE6"
                        android:textSize="26sp" />
                </LinearLayout>

                <!-- Upcoming Sessions -->
                <LinearLayout
                    android:id="@+id/card_sessions"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_card"
                    android:padding="16dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/icon_sessions"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_sessions"
                        app:tint="#18FCE6" />

                    <TextView
                        android:id="@+id/tv_label_sessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Upcoming\nSessions"
                        android:textColor="#DFFFF8"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_count_sessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="2"
                        android:textColor="#18FCE6"
                        android:textSize="26sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- BIG ADD SKILL BUTTON -->
            <LinearLayout
                android:id="@+id/layout_add_skill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="60dp">

                <FrameLayout
                    android:id="@+id/btn_add_skill"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_add_skill_circle"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/add_unsel"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_add_skill_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="+ Add Skill"
                    android:textColor="#7AF2DD"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
