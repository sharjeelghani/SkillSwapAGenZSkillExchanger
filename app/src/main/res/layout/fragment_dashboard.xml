<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020C15">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- TOP STATS SECTION -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">

                <!-- My Skills Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card_my_skills"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="140dp"
                    android:background="@drawable/bg_stat_card"
                    android:padding="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/card_matches"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintHorizontal_chainStyle="spread">

                    <ImageView
                        android:id="@+id/icon_my_skills"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_my_skills"
                        app:tint="#18FCE6"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_label_my_skills"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="My Skills"
                        android:textColor="#DFFFF8"
                        android:textSize="14sp"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/icon_my_skills"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_count_my_skills"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="#18FCE6"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_my_skills"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Available Matches Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card_matches"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="140dp"
                    android:background="@drawable/bg_stat_card"
                    android:padding="12dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintStart_toEndOf="@id/card_my_skills"
                    app:layout_constraintEnd_toStartOf="@+id/card_sessions"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHorizontal_weight="1.2">

                    <ImageView
                        android:id="@+id/icon_matches"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_matches"
                        app:tint="#18FCE6"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_label_matches"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Available Matches"
                        android:textColor="#DFFFF8"
                        android:textSize="14sp"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/icon_matches"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_count_matches"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="#18FCE6"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_matches"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Upcoming Sessions Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card_sessions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="140dp"
                    android:background="@drawable/bg_stat_card"
                    android:padding="12dp"
                    app:layout_constraintStart_toEndOf="@id/card_matches"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHorizontal_weight="1">

                    <ImageView
                        android:id="@+id/icon_sessions"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sessions"
                        app:tint="#18FCE6"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_label_sessions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Upcoming Sessions"
                        android:textColor="#DFFFF8"
                        android:textSize="14sp"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/icon_sessions"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_count_sessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="#18FCE6"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_sessions"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BIG ADD SKILL BUTTON -->
            <LinearLayout
                android:id="@+id/layout_add_skill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="40dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:layout_constraintTop_toBottomOf="@id/layout_stats_row"
                app:layout_constraintBottom_toBottomOf="parent">

                <FrameLayout
                    android:id="@+id/btn_add_skill"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_add_skill_circle"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/add_unsel"
                        android:scaleType="centerInside"
                        android:padding="40dp"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_add_skill_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="+ Add Skill"
                    android:textColor="#7AF2DD"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
