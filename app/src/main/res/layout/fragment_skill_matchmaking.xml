<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020C15">

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminateTint="#8BFDE5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Searching for matches..."
            android:textColor="#8BFDE5"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Container for the card -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/card_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- Outer rounded card -->
        <LinearLayout
            android:id="@+id/match_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_match_card"
            android:layout_margin="24dp"
            android:padding="18dp"
            android:visibility="visible">

            <!-- TOP PILL -->
            <TextView
                android:id="@+id/tv_header"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="Perfect Swap Match"
                android:textColor="#E8FFF9"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_connect"
                android:layout_marginBottom="16dp"/>

            <!-- PROFILE IMAGE (Circular) -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/profile_ring"
                android:padding="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/man"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    android:padding="2dp"/>
            </FrameLayout>

            <!-- NAME -->
            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_gravity="center_horizontal"
                android:text="Name"
                android:textColor="#8BFDE5"
                android:textStyle="bold"
                android:textSize="22sp"/>

            <!-- MATCHED TEACHING SKILLS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="They Can Teach You"
                android:textColor="#8BFDE5"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A8BFDE5"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_teaching_matches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingVertical="4dp"
                app:chipSpacingHorizontal="8dp" />

            <!-- MATCHED LEARNING SKILLS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="They Want To Learn From You"
                android:textColor="#8BFDE5"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A8BFDE5"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_learning_matches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingVertical="4dp"
                app:chipSpacingHorizontal="8dp" />

            <!-- Action Buttons Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- CONNECT BUTTON -->
                    <TextView
                        android:id="@+id/btn_connect"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_btn_connect"
                        android:gravity="center"
                        android:text="Connect"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="17sp"/>

                    <!-- PASS BUTTON -->
                    <TextView
                        android:id="@+id/btn_pass"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_btn_view_profile"
                        android:gravity="center"
                        android:text="Pass"
                        android:textColor="#8BFDE5"
                        android:textStyle="bold"
                        android:textSize="17sp"/>
                </LinearLayout>

                <!-- VIEW PROFILE BUTTON -->
                <TextView
                    android:id="@+id/btn_view_profile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_view_profile"
                    android:gravity="center"
                    android:text="View Profile"
                    android:textColor="#8BFDE5"
                    android:textStyle="bold"
                    android:textSize="17sp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
