<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020C15">

    <!-- Center the card in the fragment -->
    <LinearLayout
        android:id="@+id/card_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Outer rounded card -->
        <LinearLayout
            android:id="@+id/match_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_match_card"
            android:padding="18dp">

            <!-- TOP PILL: Perfect Swap Match -->
            <TextView
                android:id="@+id/tv_header"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="Perfect Swap Match"
                android:textColor="#E8FFF9"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_connect"
                android:layout_marginBottom="16dp"/>

            <!-- PROFILE IMAGE -->
            <ImageView
                android:id="@+id/img_avatar"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:src="@drawable/man"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_ring"
                android:layout_marginTop="4dp"/>

            <!-- NAME -->
            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"
                android:text="Scarlett Zhao"
                android:textColor="#8BFDE5"
                android:textStyle="bold"
                android:textSize="24sp"/>

            <!-- SKILL TAGS -->
            <LinearLayout
                android:id="@+id/layout_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_gravity="center_horizontal">

                <TextView
                    android:id="@+id/tag_skill_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_skill_chip"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Video Editing"
                    android:textColor="#E8FFF9"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tag_skill_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_skill_chip"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Learning Guitar"
                    android:textColor="#E8FFF9"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="22dp"
                android:weightSum="2">

                <!-- CONNECT BUTTON -->
                <TextView
                    android:id="@+id/btn_connect"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_connect"
                    android:gravity="center"
                    android:text="Connect"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <!-- PASS BUTTON -->
                <TextView
                    android:id="@+id/btn_pass"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_view_profile"
                    android:gravity="center"
                    android:text="Pass"
                    android:textColor="#8BFDE5"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

            </LinearLayout>

            <!-- VIEW PROFILE BUTTON -->
            <TextView
                android:id="@+id/btn_view_profile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_btn_view_profile"
                android:gravity="center"
                android:text="View Profile"
                android:textColor="#8BFDE5"
                android:textStyle="bold"
                android:textSize="18sp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
