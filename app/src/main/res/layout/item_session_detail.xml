<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#0D2C2C"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_session_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Session Title"
            android:textColor="#8BFDE5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_other_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="With: User Name"
            android:textColor="#C3FFF9"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_session_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date: 25/12/2023"
                android:textColor="#E8FFF9"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_session_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Time: 05:00 PM"
                android:textColor="#E8FFF9"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_session_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_role_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="PENDING"
            android:textColor="#02141C"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>