<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="16dp"
    android:background="@drawable/chat_item_bg">

    <!-- Profile Image -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profileImage"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/avatar"
        android:scaleType="centerCrop"
        android:padding="2dp"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        android:background="@drawable/profile_round"/>

    <!-- TEXTS -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <!-- Name + Timestamp -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sharjeel Ghani"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 AM"
                android:textColor="#79EAD1"
                android:textSize="13sp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <!-- Message Preview -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Would this time work for you?"
            android:textColor="#A8F2DD"
            android:textSize="15sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Green Status Dot -->
    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/online_dot"
        android:layout_marginStart="10dp"/>
</LinearLayout>
