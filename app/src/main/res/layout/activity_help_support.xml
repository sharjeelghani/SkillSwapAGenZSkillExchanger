<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:padding="8dp"
        android:src="@drawable/ic_back_activity"
        app:tint="@color/teal_light"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <!-- Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/help_support"
        android:textAllCaps="true"
        android:textSize="@dimen/title_size"
        android:textColor="@color/teal_light"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="@dimen/screen_padding"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- FAQ Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/faqs"
                android:textColor="@color/teal_light"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/faq_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- FAQ 1 -->
                <LinearLayout
                    android:id="@+id/faq1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/neon_card"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/q1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="How do I swap skills?"
                        android:textColor="@color/teal_light"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:drawableEnd="@drawable/ic_arrow_down" />
                    <TextView
                        android:id="@+id/a1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="You can search for users with the skills you want to learn, Match with them and send them a message, and agree on a swap."
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- FAQ 2 -->
                <LinearLayout
                    android:id="@+id/faq2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/neon_card"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/q2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Is Skill Swap free?"
                        android:textColor="@color/teal_light"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:drawableEnd="@drawable/ic_arrow_down" />
                    <TextView
                        android:id="@+id/a2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Yes, the core experience for this app of swapping skills is completely free for all users."
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- FAQs -->
                <LinearLayout
                    android:id="@+id/faq3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/neon_card"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/q3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="How do I verify my profile?"
                        android:textColor="@color/teal_light"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:drawableEnd="@drawable/ic_arrow_down" />
                    <TextView
                        android:id="@+id/a3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Go to settings and upload your CNIC for verification to get a verified badge."
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- FAQ 4 -->
                <LinearLayout
                    android:id="@+id/faq4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/neon_card"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/q4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Can I report a user?"
                        android:textColor="@color/teal_light"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:drawableEnd="@drawable/ic_arrow_down" />
                    <TextView
                        android:id="@+id/a4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Yes, you can report any user from their profile or the report section in Help and Support."
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- FAQ 5 -->
                <LinearLayout
                    android:id="@+id/faq5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/neon_card"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp">
                    <TextView
                        android:id="@+id/q5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="What are badges?"
                        android:textColor="@color/teal_light"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:drawableEnd="@drawable/ic_arrow_down" />
                    <TextView
                        android:id="@+id/a5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Badges are rewards for your activities and successful skill swaps on the platform."
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Contact Section -->
            <LinearLayout
                android:id="@+id/contact_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:background="@drawable/neon_card"
                android:layout_marginBottom="@dimen/card_margin">

                <TextView
                    android:id="@+id/contact_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_support"
                    android:textColor="@color/teal_light"
                    android:textSize="@dimen/card_title_size"/>
                <TextView
                    android:id="@+id/report_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/card_sub_size"
                    android:layout_marginTop="@dimen/sub_margin_top"/>

                <!-- Buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/button_row_margin"
                    android:gravity="center"
                    android:weightSum="2">

                    <RelativeLayout
                        android:id="@+id/email_button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/neon_button_outline"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/email_us"
                            android:textColor="@color/teal_light"
                            android:textSize="@dimen/button_text_size"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/chat_button"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="1"
                        android:background="@drawable/neon_button_outline"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chat_with_us"
                            android:textSize="@dimen/button_text_size"
                            android:textColor="@color/teal_light"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
