<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4CDBA9"
    app:elevation="0dp"
    tools:context=".MainActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/app_bar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#103238">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/drawer_icon_home"
                            android:layout_width="55dp"
                            android:layout_height="match_parent"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/menu_anim"
                            app:lottie_speed="1" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_app_title"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:text="Skill Swap"
                        android:textColor="#E6E6FA"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/btn_search_header"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginEnd="10dp"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/searching"
                        app:lottie_speed="1" />

                    <RelativeLayout
                        android:id="@+id/layout_messages_header"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/btn_messages_header"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_messages"
                            android:contentDescription="Messages" />

                        <View
                            android:id="@+id/dot_unread_messages"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_alignTop="@id/btn_messages_header"
                            android:layout_alignEnd="@id/btn_messages_header"
                            android:layout_marginTop="-1dp"
                            android:layout_marginEnd="-1dp"
                            android:background="@drawable/bg_unread_dot"
                            android:visibility="gone" />
                    </RelativeLayout>

                </LinearLayout>

            </androidx.appcompat.widget.Toolbar>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/app_bar"
                android:background="#E6E6FA">


                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/tabs"
                    android:background="#315C63"
                    android:paddingStart="2dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="2dp"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:background="#103238"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabMode="auto"
                    app:tabRippleColor="@null"
                    app:tabSelectedTextColor="#E6E6FA"
                    app:tabTextAppearance="@style/MyTabLayoutTextAppearance"
                    app:tabTextColor="#777777" />


            </RelativeLayout>





        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <!-- Drawer view -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="270dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#184249"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/drawer_header"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="30dp">


                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/ic_skill_swap_logo" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/nunito_regular"
                    android:text="Skill Swap"
                    android:textColor="#E6E6FA"
                    android:textSize="20sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="60dp"
                >
                <LinearLayout
                    android:layout_width="280dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/cnicvar_nav"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginLeft="20dp"
                                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:gravity="center"
                android:background="@drawable/bg_reject"
                android:elevation="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:text="CNIC Verification"
                        android:textColor="#E6E6FA"
                        android:textSize="15dp"
                        android:textStyle="bold">

                    </TextView>
            </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/help_Support_nav"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginLeft="20dp"
                                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_reject"
                    android:elevation="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:text="Help and Support"
                        android:textColor="#E6E6FA"
                        android:textSize="15dp"
                        android:textStyle="bold">

                    </TextView>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/session_rate_nav"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginLeft="20dp"
                                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_reject"
                    android:elevation="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:text="Session Feedback"
                        android:visibility="gone"
                        android:textColor="#E6E6FA"
                        android:textSize="15dp"
                        android:textStyle="bold">

                    </TextView>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/report_user_nav"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginLeft="20dp"
                                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_reject"
                    android:elevation="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:text="Report User"
                        android:textColor="#E6E6FA"
                        android:textSize="15dp"
                        android:textStyle="bold">

                    </TextView>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/search_user_nav"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginLeft="20dp"
                                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_reject"
                    android:elevation="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:text="Search User"
                        android:textColor="#E6E6FA"
                        android:textSize="15dp"
                        android:textStyle="bold">

                    </TextView>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/session_details_nav"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginLeft="20dp"
                                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_reject"
                    android:elevation="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:text="Session Details"
                        android:textColor="#E6E6FA"
                        android:textSize="15dp"
                        android:textStyle="bold">

                    </TextView>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/session_reminder_nav"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginLeft="20dp"
                                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_reject"
                    android:elevation="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:text="Session Reminder"
                        android:textColor="#E6E6FA"
                        android:textSize="15dp"
                        android:textStyle="bold">

                    </TextView>
            </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/chat_system_nav"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="20dp"
                        android:gravity="center"
                        android:background="@drawable/bg_reject"
                        android:elevation="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="20dp"
                            android:text="Chat System"
                            android:textColor="#E6E6FA"
                            android:textSize="15dp"
                            android:textStyle="bold">

                        </TextView>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/data_collextion_nav"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="20dp"
                        android:gravity="center"
                        android:background="@drawable/bg_reject"
                        android:elevation="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="20dp"
                            android:text="Data Collection"
                            android:textColor="#E6E6FA"
                            android:textSize="15dp"
                            android:textStyle="bold">

                        </TextView>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/skill_test_nav"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="20dp"
                        android:gravity="center"
                        android:background="@drawable/bg_reject"
                        android:elevation="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="20dp"
                            android:text="Skill Test"
                            android:textColor="#E6E6FA"
                            android:textSize="15dp"
                            android:textStyle="bold">

                        </TextView>
                    </RelativeLayout>

                    <RelativeLayout
                    android:id="@+id/settings_nav"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginLeft="20dp"
                                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:gravity="center"
                    android:background="@drawable/bg_reject"
                    android:elevation="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:text="Settings"
                        android:textColor="#E6E6FA"
                        android:textSize="15dp"
                        android:textStyle="bold">

                    </TextView>
                </RelativeLayout>


                </LinearLayout>
            </ScrollView>

        </LinearLayout>

        <TextView
            android:layout_width="250dp"
            android:layout_height="27dp"
            android:layout_gravity="bottom|center"
            android:layout_marginBottom="25dp"
            android:text="Learn and Grow Together!"
            android:textAlignment="center"
            android:textColor="#E6E6FA"
            android:textSize="14sp"
            android:textStyle="bold|italic">

        </TextView>
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>