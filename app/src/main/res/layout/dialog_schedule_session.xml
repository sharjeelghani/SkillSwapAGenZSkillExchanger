<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_match_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Schedule Session"
        android:textColor="#8BFDE5"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/et_session_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="What will you teach?"
        android:textColor="#E8FFF9"
        android:textColorHint="#5CD9C0"
        android:background="@drawable/bg_message_input"
        android:padding="12dp"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_select_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Date"
        android:textColor="#E8FFF9"
        android:background="@drawable/bg_message_input"
        android:padding="12dp"
        android:textSize="16sp"
        android:drawableEnd="@drawable/ic_calendar"
        app:drawableTint="#8BFDE5"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_select_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Time"
        android:textColor="#E8FFF9"
        android:background="@drawable/bg_message_input"
        android:padding="12dp"
        android:textSize="16sp"
        android:drawableEnd="@drawable/ic_clock"
        app:drawableTint="#8BFDE5"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_view_profile"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#8BFDE5"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/btn_schedule"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_connect"
            android:gravity="center"
            android:text="Schedule"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"/>

    </LinearLayout>

</LinearLayout>