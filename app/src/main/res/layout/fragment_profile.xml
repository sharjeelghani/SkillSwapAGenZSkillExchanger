<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#061B1D"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- PROFILE IMAGE -->
        <FrameLayout
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:background="@drawable/profile_ring"
            android:padding="4dp">

            <ImageView
                android:id="@+id/profile_pic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/man"
                android:scaleType="fitCenter"
                android:background="@drawable/profile_round"/>
        </FrameLayout>

        <!-- NAME -->
        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sharjeel Ghani"
            android:textColor="#C3FFF9"
            android:layout_gravity="center"
            android:paddingTop="16dp"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"/>

        <!-- LOCATION -->
        <TextView
            android:id="@+id/location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Islamabad"
            android:layout_gravity="center"
            android:textColor="#7AF2DD"
            android:textSize="16sp"
            android:paddingTop="4dp"/>

        <!-- TAB MENU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="25dp">

            <TextView
                android:text="Skills"
                android:textColor="#65FFE7"
                android:textSize="18sp"
                android:padding="8dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <TextView
                android:text="Sessions"
                android:textColor="#336B6E"
                android:padding="8dp"
                android:textSize="18sp"
                android:layout_marginStart="28dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <TextView
                android:text="Badges"
                android:textColor="#336B6E"
                android:padding="8dp"
                android:textSize="18sp"
                android:layout_marginStart="28dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <TextView
                android:text="Certificates"
                android:textColor="#336B6E"
                android:padding="8dp"
                android:textSize="18sp"
                android:layout_marginStart="28dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>
        </LinearLayout>

        <!-- SKILLS TO OFFER -->
        <TextView
            android:text="Skills to Offer"
            android:textColor="#C3FFF9"
            android:textSize="20sp"
            android:paddingTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

        <!-- PYTHON CARD -->
        <androidx.cardview.widget.CardView
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#00000000"
            app:cardCornerRadius="18dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:background="@drawable/bg_cnic_card"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_python"/>

                <TextView
                    android:text="Python"
                    android:textColor="#C2FFF5"
                    android:layout_marginStart="14dp"
                    android:textSize="18sp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="Expert"
                    android:textSize="16sp"
                    android:textColor="#65FFE7"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PHOTOGRAPHY CARD -->
        <androidx.cardview.widget.CardView
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#00000000"
            app:cardCornerRadius="18dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:background="@drawable/bg_cnic_card"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_camera"/>

                <TextView
                    android:text="Photography"
                    android:textColor="#C2FFF5"
                    android:layout_marginStart="14dp"
                    android:textSize="18sp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="Intermediate"
                    android:textSize="16sp"
                    android:textColor="#65FFE7"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- SKILLS TO LEARN -->
        <TextView
            android:text="Skills to Learn"
            android:textColor="#C3FFF9"
            android:textSize="20sp"
            android:paddingTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>

        <!-- ROW OF LEARNING CARDS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="100dp"
                android:backgroundTint="#00000000"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_cnic_card"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/ic_tutor"/>

                    <TextView
                        android:text="Top Tutor"
                        android:textColor="#C2FFF5"
                        android:textSize="16sp"
                        android:paddingTop="10dp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="100dp"
                android:backgroundTint="#00000000"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_cnic_card"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/ic_camera"/>

                    <TextView
                        android:text="Camera Pro"
                        android:textColor="#C2FFF5"
                        android:textSize="16sp"
                        android:paddingTop="10dp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>