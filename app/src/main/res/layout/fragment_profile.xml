<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#061B1D"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- PROFILE IMAGE -->
            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:background="@drawable/profile_ring"
                android:padding="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profile_pic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/man"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    android:padding="2dp"/>
            </FrameLayout>

            <!-- NAME -->
            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="#C3FFF9"
                android:layout_gravity="center"
                android:paddingTop="16dp"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"/>

            <!-- JOB -->
            <TextView
                android:id="@+id/tv_job"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Job"
                android:layout_gravity="center"
                android:textColor="#A8F2DD"
                android:textSize="18sp"
                android:paddingTop="4dp"/>

            <!-- LOCATION -->
            <TextView
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:layout_gravity="center"
                android:textColor="#7AF2DD"
                android:textSize="16sp"
                android:paddingTop="2dp"/>

            <!-- MY CONNECTIONS BUTTON -->
            <TextView
                android:id="@+id/btn_my_connections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_view_profile"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="My Connections"
                android:textColor="#19FDE8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- TAB MENU -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#061B1D"
        app:tabIndicatorColor="#65FFE7"
        app:tabSelectedTextColor="#65FFE7"
        app:tabTextColor="#336B6E"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextAppearance="@style/CustomTabTextAppearance"/>

    <!-- FRAGMENT VIEWER -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
