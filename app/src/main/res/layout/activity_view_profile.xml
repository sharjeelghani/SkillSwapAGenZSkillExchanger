<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#061B1D"
    android:orientation="vertical">

    <!-- AppBar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back_activity"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="User Profile"
            android:textColor="#27F3B3"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- PROFILE IMAGE -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/profile_ring"
                android:padding="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profile_pic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/man"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    android:padding="2dp"/>
            </FrameLayout>

            <!-- NAME -->
            <TextView
                android:id="@+id/tv_full_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="#C3FFF9"
                android:layout_gravity="center"
                android:paddingTop="20dp"
                android:textSize="30sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>

            <!-- USERNAME -->
            <TextView
                android:id="@+id/tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="username"
                android:textColor="#7AF2DD"
                android:layout_gravity="center"
                android:textSize="16sp"
                android:alpha="0.8"/>
            <!-- MATCH BUTTON -->
            <TextView
                android:id="@+id/btn_match"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_btn_connect"
                android:gravity="center"
                android:text="Connect"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <!-- DETAILS CARDs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:background="@drawable/neon_card"
                android:padding="20dp">

                <!-- Job -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_tutor"
                        app:tint="#27F3B3"/>
                    <TextView
                        android:id="@+id/tv_job_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Software Engineer"
                        android:textColor="#E8FFF9"
                        android:textSize="17sp"/>
                </LinearLayout>

                <!-- Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_google"
                        app:tint="#27F3B3"/>
                    <TextView
                        android:id="@+id/tv_location_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Islamabad, Pakistan"
                        android:textColor="#E8FFF9"
                        android:textSize="17sp"/>
                </LinearLayout>

                <!-- Gender (Replaced Email) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_account"
                        app:tint="#27F3B3"/>
                    <TextView
                        android:id="@+id/tv_gender_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Gender"
                        android:textColor="#E8FFF9"
                        android:textSize="17sp"/>
                </LinearLayout>

                <!-- Education (New field) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_certificate"
                        app:tint="#27F3B3"/>
                    <TextView
                        android:id="@+id/tv_education_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Education"
                        android:textColor="#E8FFF9"
                        android:textSize="17sp"/>
                </LinearLayout>

                <!-- Experience -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_clock"
                        app:tint="#27F3B3"/>
                    <TextView
                        android:id="@+id/tv_experience_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="3 Years Experience"
                        android:textColor="#E8FFF9"
                        android:textSize="17sp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- SKILLS SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Teaching Skills"
                android:textColor="#27F3B3"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_teaching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingVertical="8dp"
                app:chipSpacingHorizontal="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Learning Interests"
                android:textColor="#27F3B3"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_learning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingVertical="8dp"
                app:chipSpacingHorizontal="8dp"/>

            <!-- REPORT USER BUTTON -->
            <TextView
                android:id="@+id/btn_report_user"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/bg_btn_view_profile"
                android:gravity="center"
                android:text="Report User"
                android:textColor="#FF4D4D"
                android:textStyle="bold"
                android:textSize="18sp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>